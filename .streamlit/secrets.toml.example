# Copy this file to .streamlit/secrets.toml and fill in your own values.
# secrets.toml is listed in .gitignore, so it is never uploaded to GitHub.

# The SEC requires every request to identify who is making it.
# Format: "Your Name your.email@example.com"
SEC_USER_AGENT = "Your Name your.email@example.com"

# Your Anthropic API key, from https://console.anthropic.com/
ANTHROPIC_API_KEY = "paste-your-key-here"

# Free Finnhub API key for headlines, from https://finnhub.io/register
FINNHUB_API_KEY = "paste-your-key-here"
